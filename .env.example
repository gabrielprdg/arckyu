# Copie para .env.local e preencha com os dados do seu projeto Supabase (Project Settings → API Keys).
# Só a URL e a chave pública (publishable/anon). NUNCA coloque a service_role/secret key aqui: tudo com VITE_ vai para o navegador.
VITE_SUPABASE_URL=https://SEU-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só no npm run dev: pula o login e guarda os desenhos no navegador (não vale no build de produção).
# VITE_DEV_SKIP_AUTH=true
